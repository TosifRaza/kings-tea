NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/kings-tea
MONGODB_DATABASE=kings-tea
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Product image upload storage (private credentials stay on the API server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Checkout settings, prices are INR. Tax defaults to 0 until configured.
FREE_SHIPPING_THRESHOLD_INR=1000
SHIPPING_FLAT_RATE_INR=99
TAX_RATE_PERCENT=0

# Razorpay checkout (Razorpay Dashboard -> API Keys and Webhooks).
# Checkout stays disabled until all three values are present.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Catalog seed is development-only and still requires an admin session.
ENABLE_CATALOG_SEED=false

# Used only by `npm run admin:bootstrap`; never use a customer password here.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
